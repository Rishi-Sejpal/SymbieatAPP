# SymbiEat environment — copy to .env and fill in.
# Everything works in DEMO_MODE without any keys.

NODE_ENV=development
PORT=5000

# MongoDB (Atlas free tier recommended). Leave unset for the built-in in-memory demo DB.
MONGODB_URI=

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Razorpay (UPI + cards). Leave unset for simulated payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Web client URL (CORS + redirects)
CLIENT_URL=http://localhost:5173
